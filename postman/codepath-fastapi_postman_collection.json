    {
      "name": "Contest",
      "item": [
        {
          "name": "POST /api/contest/select-problems",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 2xx\", () => { pm.expect(pm.response.code).to.be.oneOf([200]); });",
                  "pm.test(\"Standard envelope {success, message, data}\", () => {",
                  "  pm.response.to.be.json;",
                  "  const j = pm.response.json();",
                  "  pm.expect(j).to.have.property(\"success\").that.is.a(\"boolean\");",
                  "  pm.expect(j).to.have.property(\"message\").that.is.a(\"string\");",
                  "  pm.expect(j).to.have.property(\"data\");",
                  "});",
                  "pm.test(\"Response has criteria + totalProblems + problems\", () => {",
                  "  const body = pm.response.json().data;",
                  "  pm.expect(body).to.have.property(\"criteria\");",
                  "  pm.expect(body).to.have.property(\"totalProblems\");",
                  "  pm.expect(body).to.have.property(\"problems\");",
                  "  pm.expect(body.problems).to.be.an(\"array\").with.lengthOf(12);",
                  "});",
                  "pm.test(\"Contest has timing\", () => {",
                  "  const body = pm.response.json().data;",
                  "  pm.expect(body).to.have.property(\"contestTiming\");",
                  "  pm.expect(body.contestTiming).to.have.property(\"startTime\");",
                  "  pm.expect(body.contestTiming).to.have.property(\"endTime\");",
                  "});",
                  "pm.test(\"Each problem has name, rating, tags, link\", () => {",
                  "  const problems = pm.response.json().data.problems;",
                  "  problems.forEach(p => {",
                  "    pm.expect(p).to.have.property(\"name\");",
                  "    pm.expect(p).to.have.property(\"rating\");",
                  "    pm.expect(p).to.have.property(\"tags\");",
                  "    pm.expect(p).to.have.property(\"link\");",
                  "    pm.expect(p).to.have.property(\"difficultyTier\");",
                  "  });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"u1\",\n  \"targetSkillTier\": \"Intermediate\",\n  \"topics\": [\n    { \"id\": 1, \"title\": \"Arrays\" },\n    { \"id\": 2, \"title\": \"Strings\" },\n    { \"id\": 3, \"title\": \"Greedy\" }\n  ],\n  \"quizPerformance\": [\n    { \"topic\": \"Arrays\", \"attempts\": 10, \"solved\": 4 },\n    { \"topic\": \"Strings\", \"attempts\": 8, \"solved\": 5 }\n  ],\n  \"totalProblems\": 12\n}"
